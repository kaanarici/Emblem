{
  "name": "emblem-server",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contracts": "CONTRACTS_WRITE=1 vitest run tests/contractFixtures.test.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build",
    "check:fast": "node scripts/check-fast.mjs",
    "lint": "eslint . && node scripts/check-no-comments.mjs && node scripts/max-lines.mjs && knip",
    "lint:ratchet": "node scripts/max-lines.mjs --write",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ai-sdk/cerebras": "^3.0.6",
    "@ai-sdk/fal": "3.0.10",
    "@ai-sdk/google": "^4.0.22",
    "@ai-sdk/groq": "^4.0.6",
    "@ai-sdk/openai": "4.0.9",
    "@ai-sdk/openai-compatible": "^3.0.6",
    "@clerk/backend": "^3.11.1",
    "@composio/core": "^0.13.1",
    "@composio/vercel": "^0.11.0",
    "@convex-dev/rate-limiter": "0.3.2",
    "ai": "^7.0.18",
    "convex": "^1.42.1",
    "next": "16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "0.35.5",
    "ws": "^8.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "2.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/ws": "^8.18.1",
    "convex-test": "^0.0.54",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "knip": "6.41.0",
    "prettier": "3.9.10",
    "typescript": "^5.6.0",
    "typescript-eslint": "8.71.1",
    "vite": "^8.1.3",
    "vitest": "4.1.11"
  },
  "license": "AGPL-3.0-only"
}
